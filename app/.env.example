# Filled in by `shopify app dev` locally; set on the server for production.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://ops.loftline.studio
SCOPES=read_products,write_products,write_cart_transforms,write_discounts,read_orders,write_orders,read_customers,write_inventory,read_locations,write_files,write_metaobject_definitions,write_metaobjects,write_online_store_pages,write_online_store_navigation,write_publications,write_purchase_options

# Postgres on the app server
DATABASE_URL=postgresql://loftline:CHANGE_ME@localhost:5432/loftline_ops

# Optional: stage emails to customers (without it, stages still change; no email is sent)
SMTP_URL=
MAIL_FROM=Loftline Studio <hello@loftline.studio>
