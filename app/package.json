{
  "name": "loftline-ops",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "deploy": "shopify app deploy",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "typecheck": "graphql-codegen && react-router typegen && tsc --noEmit",
    "test": "vitest run && npm run test --workspaces --if-present",
    "test:wasm": "node scripts/test-wasm.mjs",
    "test:webhooks": "node scripts/webhook-smoke.mjs",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen"
  },
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "extensions/*"
  ],
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-router/dev": "7.18.2",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "prisma": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "vite-tsconfig-paths": "^6.0.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/cli": "^4.9.4",
    "@shopify/polaris-types": "1.0.1",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "graphql-config": "^5.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "p-map": "^4.0.0",
    "qs": "^6.16.0"
  }
}
