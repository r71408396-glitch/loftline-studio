<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'loftline-icon.svg' | asset_url }}">
    {%- endif -%}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'motion.js' | asset_url }}" type="module"></script>
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      {%- unless request.design_mode %}
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
      {%- endunless %}
    </script>
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent" class="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
