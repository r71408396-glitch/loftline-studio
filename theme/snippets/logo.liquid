{%- comment -%}
  Loftline Studio logo as inline SVG, so the two parts of the mark and each
  letter can be animated (assets/motion.js).
  Accepts: mark (default true), wordmark (default true), class (optional).
  The mark keeps its brand violet; the letters use the current text colour.
{%- endcomment -%}
{%- liquid
  assign show_mark = true
  if mark == false
    assign show_mark = false
  endif
  assign show_wordmark = true
  if wordmark == false
    assign show_wordmark = false
  endif
  assign view_box = '4 0 358 72'
  if show_wordmark == false
    assign view_box = '0 0 72 72'
  elsif show_mark == false
    assign view_box = '90 14 268 38'
  endif
-%}
<svg class="logo{% if class %} {{ class }}{% endif %}" viewBox="{{ view_box }}" aria-hidden="true" focusable="false" data-logo>
  {%- if show_mark %}
  <g class="logo__mark" transform="scale(.3)" fill="#5144EC">
    <path data-logo-frame d="M25.5,20.0L25.5,20.0 Q20,20 20.0,25.5L20.0,214.5 Q20,220 25.5,220.0L214.5,220.0 Q220,220 220.0,214.5L220.0,173.5 Q220,168 214.5,168.0L77.5,168.0 Q72,168 72.0,162.5L72.0,25.5 Q72,20 66.5,20.0Z"/>
