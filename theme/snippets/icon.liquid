{%- comment -%}
  Inline icons, 24px grid, 1.5px stroke.
  Usage: {% render 'icon', name: 'cart' %}
{%- endcomment -%}
<svg class="icon icon-{{ name }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c.9-3.4 3.6-5.5 7-5.5s6.1 2.1 7 5.5"/>
    {%- when 'cart' -%}
      <path d="M5 8h14l-1.2 10.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.5"/><circle cx="17" cy="17.5" r="1.5"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'instagram' -%}
      <rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.5"/><circle cx="16.8" cy="7.2" r=".6" fill="currentColor"/>
    {%- when 'youtube' -%}
      <rect x="3" y="6" width="18" height="12" rx="3.5"/><path d="m10.5 9.5 4 2.5-4 2.5z" fill="currentColor"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M11 9.5c.8-1.7 4.5-1.6 4.5 1.3 0 2.2-1.6 3.7-3.3 3.2M11.4 11l-1.9 8"/>
  {%- endcase -%}
</svg>
