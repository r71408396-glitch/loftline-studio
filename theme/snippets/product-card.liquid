{%- comment -%}
  Accepts: card_product, sizes (optional), lazy (optional, default true),
  quick_add (optional): adds an "Add" button for single-variant products and a
  link to choose options for the rest.
{%- endcomment -%}
{%- liquid
  assign image_sizes = sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign loading = 'lazy'
  if lazy == false
    assign loading = 'eager'
  endif
-%}
<article class="card">
  <div class="card__media">
    {%- if card_product.featured_media -%}
      {{
        card_product.featured_media
        | image_url: width: 1200
        | image_tag:
          widths: '240, 360, 480, 640, 800, 1000, 1200',
          sizes: image_sizes,
          loading: loading,
          alt: card_product.featured_media.alt
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- unless card_product.available -%}
      <span class="badge badge--sold-out card__badge">{{ 'products.sold_out' | t }}</span>
    {%- else -%}
      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="badge card__badge">{{ 'products.sale' | t }}</span>
      {%- endif -%}
    {%- endunless -%}
  </div>
  <div class="card__body">
    <h3 class="card__title">
      <a class="card__link" href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
    </h3>
    {% render 'price', product: card_product, class: 'price--small' %}
  </div>
  {%- if quick_add and card_product.available -%}
    <div class="card__quick">
      {%- if card_product.has_only_default_variant -%}
        {%- form 'product', card_product, class: 'card__quick-form', data-quick-add: '' -%}
          <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
          <button type="submit" class="button button--secondary button--full card__quick-button">
            {{ 'products.quick_add' | t }}
            <span class="visually-hidden">{{ card_product.title | escape }}</span>
          </button>
        {%- endform -%}
      {%- else -%}
        <a class="button button--secondary button--full card__quick-button" href="{{ card_product.url }}" tabindex="-1">
          {{ 'products.choose_options' | t }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</article>
