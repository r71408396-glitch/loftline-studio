<article class="section">
  <div class="page-width page-width--narrow">
    <p class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
    <h1>{{ article.title | escape }}</h1>
    {%- if article.image -%}
      <div class="card__media" style="aspect-ratio: 3 / 2; margin-bottom: var(--space-4);">
        {{
          article.image
          | image_url: width: 1600
          | image_tag: widths: '640, 800, 1000, 1200, 1600', sizes: '(min-width: 990px) 760px, 100vw', fetchpriority: 'high'
        }}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <p style="margin-top: var(--space-6);"><a href="{{ blog.url }}">{{ 'blogs.back' | t: title: blog.title }}</a></p>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
