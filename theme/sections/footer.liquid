<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              <p class="site-footer__brand">{{ shop.name }}</p>
              {%- if block.settings.text != blank -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- liquid
                assign has_social = false
                if settings.social_instagram != blank or settings.social_youtube != blank or settings.social_pinterest != blank
                  assign has_social = true
                endif
              -%}
              {%- if has_social -%}
                <ul class="social-links">
                  {%- if settings.social_instagram != blank -%}
                    <li><a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_youtube != blank -%}
                    <li><a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_pinterest != blank -%}
                    <li><a href="{{ settings.social_pinterest }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a></li>
                  {%- endif -%}
                </ul>
              {%- endif -%}

            {%- when 'menu' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <ul class="site-footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p class="status-success" role="status">{{ 'footer.newsletter_success' | t }}</p>
                {%- else -%}
                  <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'footer.newsletter_label' | t }}</label>
                  <div class="newsletter-form__row">
                    <input
                      class="input"
                      id="FooterNewsletterEmail"
                      type="email"
                      name="contact[email]"
                      autocomplete="email"
                      placeholder="{{ 'footer.newsletter_label' | t }}"
                      required
                    >
                    <button class="button" type="submit">{{ 'footer.newsletter_button' | t }}</button>
                  </div>
                  {%- if form.errors -%}
                    <p class="small" role="alert">{{ form.errors | default_errors }}</p>
                  {%- endif -%}
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="site-footer__bottom">
      {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
        {%- form 'localization', id: 'FooterLocalization', class: 'localization-form' -%}
          {%- if localization.available_countries.size > 1 -%}
            <label class="visually-hidden" for="FooterCountry">{{ 'footer.country' | t }}</label>
            <select class="select" id="FooterCountry" name="country_code" data-auto-submit>
              {%- for country in localization.available_countries -%}
                <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                  {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                </option>
              {%- endfor -%}
            </select>
          {%- endif -%}
          {%- if localization.available_languages.size > 1 -%}
            <label class="visually-hidden" for="FooterLanguage">{{ 'footer.language' | t }}</label>
            <select class="select" id="FooterLanguage" name="language_code" data-auto-submit>
              {%- for language in localization.available_languages -%}
                <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                  {{- language.endonym_name | capitalize -}}
                </option>
              {%- endfor -%}
            </select>
          {%- endif -%}
          <noscript><button class="button button--secondary" type="submit">{{ 'footer.update' | t }}</button></noscript>
        {%- endform -%}
      {%- endif -%}

      <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</small>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Modular standing desks, built to your size and delivered to your door.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "New finishes and parts, once a month" }
      ]
    }
  ]
}
{% endschema %}
