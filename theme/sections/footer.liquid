{%- comment -%}
  Footer: a large closing line with the build button, then the brand, the
  menus and the newsletter sign-up (Shopify's customer form: subscribers land
  in Customers, tagged "newsletter"), then the small print.
{%- endcomment -%}
<footer class="site-footer">
  {%- if section.settings.cta_heading != blank -%}
    <div class="site-footer__cta" data-animate="reveal">
      <h2>{{ section.settings.cta_heading | escape }}</h2>
      {%- if section.settings.cta_label != blank -%}
        <a
          class="button button--large button--glow"
          href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
          data-footer-build
          data-magnetic
        >
          {{- section.settings.cta_label | escape }}
          {% render 'icon', name: 'arrow-up-right' %}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="site-footer__grid">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="site-footer__about" {{ block.shopify_attributes }}>
            <a class="site-footer__brand" href="{{ routes.root_url }}">
              {% render 'logo', wordmark: false, class: 'site-footer__mark' %}
              <span>{{ shop.name }}</span>
            </a>
            {%- if block.settings.text != blank -%}
              <div class="site-footer__text">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- liquid
              assign has_social = false
              if settings.social_instagram != blank or settings.social_youtube != blank or settings.social_pinterest != blank
                assign has_social = true
              endif
            -%}
            {%- if has_social -%}
              <ul class="social-links">
                {%- if settings.social_instagram != blank -%}
                  <li><a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a></li>
                {%- endif -%}
                {%- if settings.social_youtube != blank -%}
                  <li><a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a></li>
                {%- endif -%}
                {%- if settings.social_pinterest != blank -%}
                  <li><a href="{{ settings.social_pinterest }}" aria-label="Pinterest">{% render 'icon', name: 'pinterest' %}</a></li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          </div>

        {%- when 'menu' -%}
          <nav class="site-footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3>{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            {%- endfor -%}
          </nav>

        {%- when 'newsletter' -%}
          <div class="site-footer__form" {{ block.shopify_attributes }}>
            {%- form 'customer', id: 'FooterNewsletter' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'footer.newsletter_label' | t }}</label>
              <div class="site-footer__form-row">
                <input
                  class="input"
                  id="FooterNewsletterEmail"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  placeholder="{{ 'footer.newsletter_label' | t }}"
                  required
                >
                <button class="button" type="submit">{{ 'footer.newsletter_button' | t }}</button>
              </div>
              {%- if form.errors -%}
                <p class="site-footer__error" role="alert">{{ form.errors | default_errors }}</p>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <dialog class="modal" aria-labelledby="NewsletterDone" data-open-on-load>
                  <h2 id="NewsletterDone">{{ 'footer.newsletter_done_title' | t }}</h2>
                  <p>{{ 'footer.newsletter_done_text' | t }}</p>
                  <button class="button" type="button" data-close-dialog>{{ 'footer.close' | t }}</button>
                </dialog>
              {%- endif -%}
            {%- endform -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="site-footer__base">
    <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</small>

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      {%- form 'localization', id: 'FooterLocalization', class: 'localization-form' -%}
        {%- if localization.available_countries.size > 1 -%}
          <label class="visually-hidden" for="FooterCountry">{{ 'footer.country' | t }}</label>
          <select class="select" id="FooterCountry" name="country_code" data-auto-submit>
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}
        {%- if localization.available_languages.size > 1 -%}
          <label class="visually-hidden" for="FooterLanguage">{{ 'footer.language' | t }}</label>
          <select class="select" id="FooterLanguage" name="language_code" data-auto-submit>
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                {{- language.endonym_name | capitalize -}}
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}
        <noscript><button class="button button--secondary" type="submit">{{ 'footer.update' | t }}</button></noscript>
      {%- endform -%}
    {%- endif -%}

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="payment-icons" aria-label="{{ 'footer.payment_methods' | t }}">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "cta_heading", "label": "Closing line", "default": "Work, beautifully." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Build your desk" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Modular standing desks, built to your size and delivered to your door.</p>"
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "New finishes and parts, once a month" }
      ]
    }
  ]
}
{% endschema %}
