{%- comment -%}
  "Complete your setup": a grid of accessory photographs with their names and
  prices; each card leans toward the pointer (assets/home.js). A card's photo
  is the block image, else a theme image (the editorial renders from
  preview/renders.html), else the product's own photo.
{%- endcomment -%}
{%- assign heading_lines = section.settings.heading | newline_to_br | replace: '<br />', '<br>' | split: '<br>' -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home.js' | asset_url }}" type="module"></script>

<section class="lh-section" id="accessories" aria-labelledby="AccessoriesHeading-{{ section.id }}">
  <div class="lh-wrap">
    <div class="lh-acc-head">
      <div data-animate="reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="lh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="AccessoriesHeading-{{ section.id }}">
          {%- for line in heading_lines -%}
            {{ line | strip | escape }}{% unless forloop.last %}<br>{% endunless %}
          {%- endfor -%}
        </h2>
      </div>
      {%- if section.settings.button_label != blank -%}
        <a class="lh-link-arrow lh-link-accent" href="{{ section.settings.button_link | default: routes.collections_url }}">
          {{- section.settings.button_label | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <div class="lh-acc-grid" data-animate="stagger">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product == blank -%}{%- continue -%}{%- endif -%}
        <a class="lh-acc" href="{{ product.url }}" data-tilt {{ block.shopify_attributes }}>
          <div class="lh-acc-photo">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 961px) 25vw, 50vw', alt: block.settings.alt | default: product.title }}
            {%- elsif block.settings.theme_image != blank -%}
              <img src="{{ block.settings.theme_image | asset_url }}" width="1200" height="900" loading="lazy" alt="{{ block.settings.alt | default: product.title | escape }}">
            {%- elsif product.featured_image -%}
              {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200', sizes: '(min-width: 961px) 25vw, 50vw' }}
            {%- endif -%}
          </div>
          <div class="lh-acc-meta">
            <h3>{{ product.title | escape }}</h3>
            <span>{{ product.price | money }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home accessories",
  "class": "section-home-accessories",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Make it yours" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "One line per row", "default": "Complete\nyour setup." },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Explore accessories" },
    { "type": "url", "id": "button_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Photograph" },
        {
          "type": "text",
          "id": "theme_image",
          "label": "Theme image file",
          "info": "Used when no photograph is chosen, e.g. editorial-monitor-arm.webp"
        },
        { "type": "text", "id": "alt", "label": "Photo description" }
      ]
    }
  ],
  "presets": [{ "name": "Home accessories" }]
}
{% endschema %}
