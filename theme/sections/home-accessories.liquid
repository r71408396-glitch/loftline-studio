{%- comment -%}
  "Complete your setup": large photographs of the accessories, a sideways row
  on smaller screens (assets/home.js, <card-scroller>). Each block is a product;
  its photograph is the block image, else a theme image (the editorial renders
  from preview/renders.html), else the product's own photo.
{%- endcomment -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home.js' | asset_url }}" type="module"></script>

<section class="section home-accessories" aria-labelledby="AccessoriesHeading-{{ section.id }}">
  <card-scroller class="page-width home-accessories__inner">
    <div class="home-accessories__header">
      <div data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="home-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="AccessoriesHeading-{{ section.id }}" class="home-display">
          {%- assign heading_lines = section.settings.heading | newline_to_br | replace: '<br />', '<br>' | split: '<br>' -%}
          {%- for line in heading_lines -%}
            <span class="home-display__line">{{ line | strip | escape }}</span>
          {%- endfor -%}
        </h2>
      </div>
      <div class="home-accessories__actions" data-reveal>
        <div class="home-accessories__arrows">
          <button type="button" class="icon-button home-accessories__arrow" data-prev aria-label="{{ 'sections.home_accessories.previous' | t }}">
            {% render 'icon', name: 'chevron-left' %}
          </button>
          <button type="button" class="icon-button home-accessories__arrow" data-next aria-label="{{ 'sections.home_accessories.next' | t }}">
            {% render 'icon', name: 'chevron-right' %}
          </button>
        </div>
        {%- if section.settings.button_label != blank -%}
          <a class="button button--outline" href="{{ section.settings.button_link | default: routes.collections_url }}">
            {{- section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow-up-right' %}
          </a>
        {%- endif -%}
      </div>
    </div>

    <ul class="home-accessories__track" role="list" data-track>
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product == blank -%}{%- continue -%}{%- endif -%}
        <li class="accessory-card" data-reveal {{ block.shopify_attributes }}>
          <a class="accessory-card__link" href="{{ product.url }}">
            <div class="accessory-card__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 31vw, 80vw', alt: product.title }}
              {%- elsif block.settings.theme_image != blank -%}
                <img src="{{ block.settings.theme_image | asset_url }}" width="1200" height="900" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
              {%- elsif product.featured_image -%}
                {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000, 1200', sizes: '(min-width: 990px) 31vw, 80vw' }}
              {%- endif -%}
            </div>
            <div class="accessory-card__body">
              <h3 class="accessory-card__title">{{ product.title | escape }}</h3>
              {% render 'price', product: product, class: 'price--small accessory-card__price' %}
              {% render 'icon', name: 'arrow-right' %}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </card-scroller>
</section>

{% schema %}
{
  "name": "Home accessories",
  "class": "section-home-accessories",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Make it yours" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "One line per row", "default": "Complete\nyour setup." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore accessories" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Photograph" },
        {
          "type": "text",
          "id": "theme_image",
          "label": "Theme image file",
          "info": "Used when no photograph is chosen, e.g. editorial-monitor-arm.webp"
        }
      ]
    }
  ],
  "presets": [{ "name": "Home accessories" }]
}
{% endschema %}
