{%- comment -%}
  Home hero (assets/home.js, <home-hero>): the dark studio with the desk, the
  headline, a finish selector and a height readout. The hero is taller than the
  screen and its inner frame sticks; scrolling through it raises the desk from
  sitting to standing height. A poster render of the chosen finish shows first;
  on wide screens with a pointer the live 3D desk takes over after the page has
  loaded. Phones keep the posters. The chosen finish travels into the desk
  builder through the button link.
  Posters: assets/hero-<top>-<frame>.webp and -mobile.webp (preview/renders.html).
{%- endcomment -%}
{%- liquid
  assign build_url = section.settings.button_link | default: routes.all_products_collection_url
  assign second_url = section.settings.second_link | default: routes.collections_url
  assign finishes = section.blocks | where: 'type', 'finish'
  assign heading_lines = section.settings.heading | newline_to_br | replace: '<br />', '<br>' | split: '<br>'
-%}
{{ 'home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home.js' | asset_url }}" type="module"></script>

{%- capture swatches -%}
  {%- for block in finishes -%}
    {%- liquid
      assign top = block.settings.top
      assign frame = block.settings.frame
      assign top_key = 'finishes.' | append: top
      assign frame_key = 'finishes.frame_' | append: frame
      assign top_label = top_key | t
      assign frame_label = frame_key | t
      assign label = top_label | append: ' / ' | append: frame_label
      case top
        when 'walnut'
          assign top_code = 'wal'
          assign top_color = '#5b3a25'
        when 'oak'
          assign top_code = 'oak'
          assign top_color = '#c99d68'
        when 'bamboo'
          assign top_code = 'bam'
          assign top_color = '#d4b676'
        when 'white'
          assign top_code = 'wht'
          assign top_color = '#ecebe7'
        else
          assign top_code = 'lin'
          assign top_color = '#2d3036'
      endcase
      case frame
        when 'white'
          assign frame_code = 'wht'
          assign frame_color = '#e9e9ec'
        when 'graphite'
          assign frame_code = 'gra'
          assign frame_color = '#4b4e57'
        when 'aluminium'
          assign frame_code = 'alu'
          assign frame_color = '#b6bac2'
        else
          assign frame_code = 'blk'
          assign frame_color = '#17181c'
      endcase
      assign code = 'm=' | append: top_code | append: '&f=' | append: frame_code | append: '&e=rounded'
      assign poster_name = 'hero-' | append: top | append: '-' | append: frame
      if block.settings.poster != blank
        assign poster = block.settings.poster | image_url: width: 2000
        assign poster_mobile = block.settings.poster | image_url: width: 900
      else
        assign poster = poster_name | append: '.webp' | asset_url
        assign poster_mobile = poster_name | append: '-mobile.webp' | asset_url
      endif
      if forloop.first
        assign first_label = label
        assign first_code = code
        assign first_poster = poster
        assign first_poster_mobile = poster_mobile
      endif
    -%}
    <button
      class="lh-swatch"
      type="button"
      aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
      data-finish
      data-top="{{ top }}"
      data-frame="{{ frame }}"
      data-code="{{ code }}"
      data-label="{{ label | escape }}"
      data-alt="{{ 'sections.home_hero.poster_alt' | t: finish: label | escape }}"
      data-poster="{{ poster }}"
      data-poster-mobile="{{ poster_mobile }}"
      {{ block.shopify_attributes }}
    >
      <span class="lh-dot" style="--c1: {{ top_color }}; --c2: {{ frame_color }};" aria-hidden="true"></span>
      <span class="lh-swatch-name">{{ top_label }}</span>
    </button>
  {%- endfor -%}
{%- endcapture -%}

<home-hero class="lh-hero-wrap" data-viewer-src="{{ 'desk-viewer.js' | asset_url }}">
  <section class="lh-hero" id="hero" aria-labelledby="HeroHeading-{{ section.id }}">
    {%- if first_poster -%}
      <picture class="lh-hero-still">
        <source media="(max-aspect-ratio: 1/1)" srcset="{{ first_poster_mobile }}" width="900" height="1600" data-poster-mobile>
        <img
          src="{{ first_poster }}"
          width="2000"
          height="1200"
          alt="{{ 'sections.home_hero.poster_alt' | t: finish: first_label }}"
          fetchpriority="high"
          decoding="async"
          data-poster
        >
      </picture>
    {%- endif -%}
    <div class="lh-hero-canvas" data-stage aria-hidden="true"></div>

    <div class="lh-hero-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="lh-eyebrow-dark" data-animate="hero" data-hero-eyebrow><span class="lh-pulse" aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="HeroHeading-{{ section.id }}" data-animate="split">
        {%- for line in heading_lines -%}
          {{ line | strip | escape }}{% unless forloop.last %}<br>{% endunless %}
        {%- endfor -%}
      </h1>
      {%- if section.settings.text != blank -%}
        <p class="lh-lede" data-animate="hero" data-hero-lede>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      <div class="lh-hero-actions" data-animate="hero">
        {%- if section.settings.button_label != blank -%}
          <a
            class="button button--large button--glow"
            href="{{ build_url }}{% if first_code %}#{{ first_code }}{% endif %}"
            data-build-link
            data-base="{{ build_url }}"
            data-magnetic
            data-hero-button
          >
            <span class="lh-shine" aria-hidden="true"></span>
            {{- section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow-up-right' %}
          </a>
        {%- endif -%}
        {%- if section.settings.second_label != blank -%}
          <a class="lh-link-arrow" href="{{ second_url }}" data-hero-link>
            {{- section.settings.second_label | escape }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
      </div>
      {%- if finishes.size > 0 -%}
        <div class="lh-hero-finish" data-animate="hero">
          <div class="lh-swatches" role="group" aria-label="{{ 'sections.home_hero.finish_heading' | t }}">
            <span class="lh-swatch-thumb" aria-hidden="true" data-swatch-thumb></span>
            {{- swatches -}}
          </div>
          <p class="lh-finish-label" aria-live="polite" data-finish-name>{{ first_label }}</p>
        </div>
      {%- endif -%}
    </div>

    <div class="lh-readout" data-animate="hero" aria-hidden="true">
      <div class="lh-readout-label">{{ 'sections.home_hero.height_label' | t }}</div>
      <div class="lh-readout-num"><span data-readout-value>72</span><small>CM</small></div>
      <div class="lh-readout-track"><span class="lh-readout-dot" data-readout-dot></span></div>
      <div class="lh-readout-hint">{{ 'sections.home_hero.scroll_hint' | t }}</div>
    </div>
  </section>
</home-hero>

{% schema %}
{
  "name": "Home hero",
  "class": "section-home-hero",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Modular standing desks, built to order" },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "One line per row",
      "default": "Your space.\nElevated."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "A desk built around the way you work: your size, your finish, your add-ons. Delivered to your door."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Build your desk" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "The desk builder page. The chosen finish is added to the link." },
    { "type": "text", "id": "second_label", "label": "Second link label", "default": "Explore accessories" },
    { "type": "url", "id": "second_link", "label": "Second link" }
  ],
  "blocks": [
    {
      "type": "finish",
      "name": "Finish",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "top",
          "label": "Top",
          "options": [
            { "value": "walnut", "label": "Walnut" },
            { "value": "oak", "label": "Oak" },
            { "value": "bamboo", "label": "Bamboo" },
            { "value": "white", "label": "White laminate" },
            { "value": "linoleum", "label": "Charcoal linoleum" }
          ],
          "default": "walnut"
        },
        {
          "type": "select",
          "id": "frame",
          "label": "Frame",
          "options": [
            { "value": "black", "label": "Black" },
            { "value": "white", "label": "White" },
            { "value": "graphite", "label": "Graphite" },
            { "value": "aluminium", "label": "Aluminium" }
          ],
          "default": "black"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster",
          "info": "Shown before the 3D desk loads, and on phones. Leave empty for walnut / black, oak / white and charcoal linoleum / graphite, which have rendered posters."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home hero",
      "blocks": [
        { "type": "finish", "settings": { "top": "walnut", "frame": "black" } },
        { "type": "finish", "settings": { "top": "oak", "frame": "white" } },
        { "type": "finish", "settings": { "top": "linoleum", "frame": "graphite" } }
      ]
    }
  ]
}
{% endschema %}
