<section class="section{% if section.settings.tint %} section--tint{% endif %}" aria-labelledby="StepsHeading-{{ section.id }}">
  <div class="page-width">
    <div class="section-header" data-reveal>
      <h2 id="StepsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    </div>
    <ol class="steps grid grid--3-tablet">
      {%- for block in section.blocks -%}
        <li class="step" data-reveal {{ block.shopify_attributes }}>
          <span class="step__number" aria-hidden="true" data-reveal-pop>{{ forloop.index }}</span>
          <h3 class="h4">{{ block.settings.title | escape }}</h3>
          <div class="rte muted">{{ block.settings.text }}</div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "class": "section-steps",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "checkbox", "id": "tint", "label": "Tinted background", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Pick your size" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Choose a width and depth that fits your room.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick your size", "text": "<p>Choose a width and depth that fits your room, from 120 to 200 cm.</p>" } },
        { "type": "step", "settings": { "title": "Choose your finish", "text": "<p>Frame colour, top material and edge, shown live in 3D.</p>" } },
        { "type": "step", "settings": { "title": "Add what you need", "text": "<p>Monitor arm, cable tray, drawer, desk pad. The more you add, the more you save.</p>" } }
      ]
    }
  ]
}
{% endschema %}
