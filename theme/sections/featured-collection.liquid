{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}
<section class="section" aria-labelledby="FeaturedHeading-{{ section.id }}">
  <div class="page-width">
    <div class="section-header">
      <h2 id="FeaturedHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if collection != blank -%}
        <a href="{{ collection.url }}">{{ 'collections.view_all' | t }}</a>
      {%- endif -%}
    </div>
    <ul class="grid grid--2 grid--4-desktop" role="list" style="list-style: none; margin: 0; padding: 0;">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          <li>{% render 'product-card', card_product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <li>
            <article class="card">
              <div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag }}</div>
              <div class="card__body">
                <h3 class="card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3>
              </div>
            </article>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Finish the setup" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
