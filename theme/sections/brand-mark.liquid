{%- comment -%}
  Brand band: the 3D Loftline emblem assembles as it scrolls into view
  (snippets/logo-3d.liquid), next to a short statement.
{%- endcomment -%}
<section
  class="section brand-mark brand-mark--{{ section.settings.scheme }}"
  aria-labelledby="BrandHeading-{{ section.id }}"
>
  <div class="page-width brand-mark__grid">
    <div class="brand-mark__text" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h2 id="BrandHeading-{{ section.id }}" class="brand-mark__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="rte brand-mark__lead">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <div class="brand-mark__visual">
      {% render 'logo-3d', mode: 'scroll' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand mark",
  "class": "section-brand-mark",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Colours",
      "options": [
        { "value": "ink", "label": "Ink background" },
        { "value": "light", "label": "Light background" }
      ],
      "default": "ink"
    },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Loftline Studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built around your space." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>An L frame. A floating line. Made to move with you.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Build yours" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Brand mark" }]
}
{% endschema %}
