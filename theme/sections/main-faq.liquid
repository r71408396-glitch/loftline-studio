{%- comment -%}
  Help page: the FAQ entries (faq_item metaobjects, Content > Metaobjects) grouped by topic,
  then the page's own text. Search engines get the same questions as FAQPage structured data.
{%- endcomment -%}
{%- liquid
  assign items = shop.metaobjects.faq_item.values
  assign topics = '|'
  for item in items
    assign topic = item.topic.value | default: section.settings.other_topic
    assign key = '|' | append: topic | append: '|'
    unless topics contains key
      assign topics = topics | append: topic | append: '|'
    endunless
  endfor
  assign topics = topics | remove_first: '|' | split: '|'
-%}
<section class="section">
  <div class="page-width page-width--narrow">
    <h1>{{ page.title | escape }}</h1>

    {%- for topic in topics -%}
      <div class="faq-group" data-reveal>
        {%- if topics.size > 1 -%}
          <h2 class="h4 faq-group__title">{{ topic | escape }}</h2>
        {%- endif -%}
        {%- for item in items -%}
          {%- assign item_topic = item.topic.value | default: section.settings.other_topic -%}
          {%- if item_topic == topic -%}
            <details class="faq-item">
              <summary>{{ item.question.value | escape }}</summary>
              <div class="rte">{{ item.answer | metafield_tag }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}

    {%- if page.content != blank -%}
      <div class="rte faq-footer">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

{%- if items.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for item in items -%}
          {
            "@type": "Question",
            "name": {{ item.question.value | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ item.answer | metafield_text | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-main-faq",
  "settings": [
    {
      "type": "paragraph",
      "content": "Questions and answers come from the FAQ item entries in Content > Metaobjects, grouped by their topic."
    },
    { "type": "text", "id": "other_topic", "label": "Heading for entries without a topic", "default": "Other questions" }
  ]
}
{% endschema %}
