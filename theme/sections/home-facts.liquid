{%- comment -%}
  "Built for the long day": a tiled grid of the numbers that matter. Numbers
  count up as they come into view (assets/home.js). The large tile shows a
  small desk rising and falling between its lowest and highest setting.
{%- endcomment -%}
{%- assign heading_lines = section.settings.heading | newline_to_br | replace: '<br />', '<br>' | split: '<br>' -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'home.js' | asset_url }}" type="module"></script>

<section class="lh-section lh-section-tint" id="why" aria-labelledby="WhyHeading-{{ section.id }}">
  <div class="lh-wrap">
    <div class="lh-section-head">
      <div data-animate="reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="lh-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="WhyHeading-{{ section.id }}">
          {%- for line in heading_lines -%}
            {{ line | strip | escape }}{% unless forloop.last %}<br>{% endunless %}
          {%- endfor -%}
        </h2>
      </div>
    </div>

    <div class="lh-bento" data-animate="stagger">
      {%- for block in section.blocks -%}
        {%- liquid
          assign classes = 'lh-tile'
          case block.settings.size
            when 'large'
              assign classes = classes | append: ' lh-tile-lg'
            when 'wide'
              assign classes = classes | append: ' lh-tile-wide'
          endcase
          case block.settings.tone
            when 'accent'
              assign classes = classes | append: ' lh-tile-accent'
            when 'dark'
              assign classes = classes | append: ' lh-tile-dark lh-tile-glow'
          endcase
        -%}
        <article class="{{ classes }}" {{ block.shopify_attributes }}>
          {%- if block.settings.size == 'large' and block.settings.lift -%}
            <div class="lh-lift-demo" aria-hidden="true">
              <div class="lh-lift-floor"></div>
              <div class="lh-lift-gauge" data-low="{{ block.settings.before | remove: 'to' | strip | append: ' CM' }}" data-high="{{ block.settings.number | append: ' CM' }}"></div>
              <div class="lh-lift-body"><div class="lh-lift-top"></div><div class="lh-lift-leg lh-l"></div><div class="lh-lift-leg lh-r"></div></div>
            </div>
          {%- endif -%}
          {%- if block.settings.number != blank -%}
            <div class="lh-stat">
              {%- if block.settings.before != blank -%}{{ block.settings.before | escape }} {% endif -%}
              <span data-animate="count" data-to="{{ block.settings.number | escape }}">{{ block.settings.number | escape }}</span>
              {%- if block.settings.unit != blank -%}<small>{{ block.settings.unit | escape }}</small>{%- endif -%}
            </div>
          {%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home facts",
  "class": "section-home-facts",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Why Loftline" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "One line per row", "default": "Built for\nthe long day." }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        { "type": "text", "id": "before", "label": "Text before the number", "info": "e.g. 62 to" },
        { "type": "text", "id": "number", "label": "Number", "info": "Counts up from 0. Leave empty for a tile with a title only." },
        { "type": "text", "id": "unit", "label": "Unit", "info": "e.g. cm, kg, yr" },
        { "type": "text", "id": "title", "label": "Title", "default": "Load" },
        { "type": "text", "id": "text", "label": "Text" },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "normal", "label": "Normal" },
            { "value": "large", "label": "Large (two by two)" },
            { "value": "wide", "label": "Full width" }
          ],
          "default": "normal"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Colours",
          "options": [
            { "value": "light", "label": "White" },
            { "value": "accent", "label": "Accent" },
            { "value": "dark", "label": "Dark with glow" }
          ],
          "default": "light"
        },
        { "type": "checkbox", "id": "lift", "label": "Rising desk drawing", "info": "Large tiles only", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home facts",
      "blocks": [
        { "type": "fact", "settings": { "before": "62 to", "number": "127", "unit": "cm", "title": "Height range", "text": "Two quiet motors and three-stage legs take the top from sitting to standing in seconds.", "size": "large", "lift": true } },
        { "type": "fact", "settings": { "number": "140", "unit": "kg", "title": "Load", "text": "Monitors, speakers, books, and your elbows." } }
      ]
    }
  ]
}
{% endschema %}
