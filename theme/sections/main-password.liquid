<div class="password-page">
  <div class="password-page__inner">
    {% render 'logo-3d', mode: 'intro', class: 'password-page__emblem' %}
    <p class="password-page__logo" data-logo-scroll>
      {% render 'logo', mark: false %}
      <span class="visually-hidden">{{ shop.name }}</span>
    </p>
    <h1 class="h2">{{ 'password.heading' | t }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="muted">{{ shop.password_message }}</p>
    {%- endif -%}
    {%- form 'storefront_password', class: 'search-form' -%}
      <label class="visually-hidden" for="Password">{{ 'password.label' | t }}</label>
      <input class="input" id="Password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}" required>
      <button class="button" type="submit">{{ 'password.enter' | t }}</button>
      {%- if form.errors -%}
        <p class="small status-error" role="alert">{{ 'password.error' | t }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "class": "section-main-password",
  "settings": []
}
{% endschema %}
