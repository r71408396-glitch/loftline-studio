{%- paginate blog.articles by 9 -%}
  <section class="section">
    <div class="page-width">
      <h1>{{ blog.title | escape }}</h1>
      <ul class="grid grid--3-tablet" role="list" style="list-style: none; margin: 0; padding: 0;">
        {%- for article in blog.articles -%}
          <li>
            <article class="card">
              <div class="card__media" style="aspect-ratio: 3 / 2;">
                {%- if article.image -%}
                  {{
                    article.image
                    | image_url: width: 1000
                    | image_tag: widths: '360, 480, 640, 800, 1000', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              <div class="card__body">
                <p class="article-card__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
                <h2 class="card__title"><a class="card__link" href="{{ article.url }}">{{ article.title | escape }}</a></h2>
                <p class="small muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
