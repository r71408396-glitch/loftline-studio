{%- comment -%}
  Product page. Choosing an option fetches this section for the new variant
  through the Section Rendering API (?option_values=...), so price, stock,
  buttons and subscription prices always come from Liquid.
{%- endcomment -%}
{{ 'product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" type="module"></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign featured_media_id = current_variant.featured_media.id | default: product.featured_media.id
-%}

<product-page class="section product" data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <div class="page-width">
    <nav class="breadcrumbs small" aria-label="{{ 'products.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'products.home' | t }}</a>
      {%- if collection -%}
        <span aria-hidden="true">/</span>
        <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="product__grid">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="product-gallery" data-gallery>
        <ul class="product-gallery__list" role="list" data-gallery-list>
          {%- for media in product.media -%}
            <li
              class="product-gallery__item{% if media.id == featured_media_id %} is-active{% endif %}"
              data-media-id="{{ media.id }}"
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    assign loading = 'lazy'
                    if forloop.first
                      assign loading = 'eager'
                    endif
                  -%}
                  <button type="button" class="product-gallery__zoom" data-zoom="{{ forloop.index0 }}" aria-label="{{ 'products.zoom' | t }}">
                    {{
                      media
                      | image_url: width: 1600
                      | image_tag:
                        widths: '480, 640, 800, 1000, 1200, 1400, 1600',
                        sizes: '(min-width: 990px) 58vw, 100vw',
                        loading: loading,
                        fetchpriority: 'auto',
                        alt: media.alt
                    }}
                  </button>
                {%- when 'external_video', 'video' -%}
                  {{ media | media_tag: image_size: '1600x' }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag: image_size: '1600x', reveal: 'interaction', toggleable: true }}
              {%- endcase -%}
            </li>
          {%- else -%}
            <li class="product-gallery__item is-active">{{ 'product-1' | placeholder_svg_tag }}</li>
          {%- endfor -%}
        </ul>
        {%- if product.media.size > 1 -%}
          <p class="product-gallery__counter small muted" aria-hidden="true">
            <span data-gallery-index>1</span> / {{ product.media.size }}
          </p>
        {%- endif -%}
      </div>

      {%- comment -%} Info column: replaced as a whole when the variant changes {%- endcomment -%}
      <div class="product__info" data-product-info data-variant-id="{{ current_variant.id }}" data-featured-media="{{ featured_media_id }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'eyebrow' -%}
              <p class="eyebrow" {{ block.shopify_attributes }}>
                {{- block.settings.text | default: product.type | escape -}}
              </p>

            {%- when 'title' -%}
              <h1 class="product__title h2" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                {% render 'price', product: product, variant: current_variant %}
                {%- if current_variant.sku != blank -%}
                  <p class="small muted product__sku">{{ 'products.sku' | t: sku: current_variant.sku }}</p>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="product__options" {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign option_handle = option.name | handle
                      assign use_swatch = false
                      if option.values.first.swatch != blank
                        assign use_swatch = true
                      endif
                      if option_handle == 'colour' or option_handle == 'color' or option_handle == 'finish'
                        assign use_swatch = true
                      endif
                    -%}
                    <fieldset class="option-group">
                      <legend class="label">
                        {{ option.name | escape }}
                        <span class="muted" style="font-weight: 400;">{{ option.selected_value | escape }}</span>
                      </legend>
                      <div class="option-group__values">
                        {%- for value in option.values -%}
                          <label class="option-pill{% if use_swatch %} option-pill--swatch{% endif %}{% unless value.available %} is-unavailable{% endunless %}">
                            <input
                              type="radio"
                              name="{{ option.name | handle }}-{{ section.id }}"
                              value="{{ value | escape }}"
                              data-option-value-id="{{ value.id }}"
                              {% if value.selected %}checked{% endif %}
                            >
                            {%- if use_swatch -%}
                              {%- liquid
                                assign swatch_style = ''
                                if value.swatch.image
                                  assign swatch_url = value.swatch.image | image_url: width: 80
                                  assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                                elsif value.swatch.color
                                  assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                                endif
                              -%}
                              <span class="swatch swatch--{{ value | handle }}" style="{{ swatch_style }}" aria-hidden="true"></span>
                              <span class="visually-hidden">{{ value | escape }}</span>
                            {%- else -%}
                              <span>{{ value | escape }}</span>
                            {%- endif -%}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">

                  {%- if product.selling_plan_groups.size > 0 -%}
                    <fieldset class="purchase-options">
                      <legend class="label">{{ 'products.purchase_options' | t }}</legend>
                      {%- unless product.requires_selling_plan -%}
                        <label class="purchase-option">
                          <input type="radio" name="selling_plan" value="" {% if current_variant.selected_selling_plan_allocation == nil %}checked{% endif %}>
                          <span class="purchase-option__text">{{ 'products.one_time' | t }}</span>
                          <span class="purchase-option__price">{{ current_variant.price | money }}</span>
                        </label>
                      {%- endunless -%}
                      {%- for group in product.selling_plan_groups -%}
                        {%- for plan in group.selling_plans -%}
                          {%- liquid
                            assign plan_price = current_variant.price
                            for allocation in current_variant.selling_plan_allocations
                              if allocation.selling_plan.id == plan.id
                                assign plan_price = allocation.price
                              endif
                            endfor
                            assign saving = ''
                            assign adjustment = plan.price_adjustments.first
                            if adjustment.value_type == 'percentage' and adjustment.value > 0
                              assign saving = 'products.save_percent' | t: percent: adjustment.value
                            endif
                          -%}
                          <label class="purchase-option">
                            <input type="radio" name="selling_plan" value="{{ plan.id }}" {% if plan.selected %}checked{% elsif product.requires_selling_plan and forloop.first %}checked{% endif %}>
                            <span class="purchase-option__text">
                              {{ plan.name | escape }}
                              {%- if saving != blank %} <span class="badge">{{ saving }}</span>{% endif -%}
                            </span>
                            <span class="purchase-option__price">{{ plan_price | money }}</span>
                          </label>
                        {%- endfor -%}
                      {%- endfor -%}
                      <p class="small muted">{{ 'products.subscription_note' | t }}</p>
                    </fieldset>
                  {%- endif -%}

                  <div class="product-form__row">
                    <div class="quantity">
                      <button type="button" class="quantity__button" data-step="-1" aria-label="{{ 'cart.decrease' | t: item: product.title }}">&minus;</button>
                      <input class="quantity__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.quantity' | t }}">
                      <button type="button" class="quantity__button" data-step="1" aria-label="{{ 'cart.increase' | t: item: product.title }}">+</button>
                    </div>
                    <button class="button" type="submit" name="add" data-add-button {% unless current_variant.available %}disabled{% endunless %}>
                      {%- if current_variant.available -%}
                        {{ 'products.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.sold_out' | t }}
                      {%- endif -%}
                    </button>
                  </div>
                  <p class="small status-error" role="alert" data-form-error hidden></p>
                  {%- if block.settings.show_dynamic_checkout and product.selling_plan_groups.size == 0 -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}

                <p class="product__stock small">
                  {%- if current_variant.available -%}
                    <span class="status-success">{% render 'icon', name: 'check' %}{{ 'products.in_stock' | t }}</span>
                  {%- else -%}
                    <span class="status-error">{{ 'products.out_of_stock' | t }}</span>
                  {%- endif -%}
                </p>
              </div>

            {%- when 'delivery' -%}
              {%- assign lead_days = product.metafields.specs.lead_time_days.value -%}
              {%- if lead_days != blank -%}
                <p class="product__delivery small" {{ block.shopify_attributes }}>
                  {% render 'icon', name: 'truck' %}
                  <span>
                    {%- if lead_days > 2 -%}
                      {{ 'products.made_to_order' | t: days: lead_days }}
                    {%- else -%}
                      {{ 'products.ships_fast' | t }}
                    {%- endif -%}
                  </span>
                </p>
              {%- endif -%}

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="rte product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'specs' -%}
              {% render 'product-specs', product: product, block: block %}

            {%- when 'material' -%}
              {%- assign material = product.metafields.specs.material.value -%}
              {%- if material != blank -%}
                <div class="product-material panel" {{ block.shopify_attributes }}>
                  <div class="product-material__head">
                    {%- if material.swatch != blank -%}
                      <span class="swatch" style="background-color: {{ material.swatch.value }};" aria-hidden="true"></span>
                    {%- endif -%}
                    <div>
                      <p class="h4">{{ material.name.value | escape }}</p>
                      {%- if material.origin != blank -%}<p class="small muted">{{ material.origin.value | escape }}</p>{%- endif -%}
                    </div>
                  </div>
                  {%- if material.summary != blank -%}<p class="small">{{ material.summary.value | escape }}</p>{%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'collapsible' -%}
              {%- liquid
                assign body = block.settings.content
                if block.settings.page != blank
                  assign body = block.settings.page.content
                endif
              -%}
              {%- if body != blank -%}
                <details class="product-details" {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.heading | escape }}</summary>
                  <div class="rte small">{{ body }}</div>
                </details>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.sticky_add -%}
    <div class="product-sticky" data-sticky aria-hidden="true">
      <div class="product-sticky__text">
        <span class="product-sticky__title">{{ product.title | escape }}</span>
        <span class="price price--small" data-sticky-price>{{ current_variant.price | money }}</span>
      </div>
      <button type="button" class="button" data-sticky-add tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}>
        {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
      </button>
    </div>
  {%- endif -%}

  <dialog class="lightbox" data-lightbox aria-label="{{ 'products.zoom' | t }}">
    <button type="button" class="icon-button lightbox__close" data-lightbox-close aria-label="{{ 'accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>
    <ul class="lightbox__list" role="list">
      {%- for media in product.media -%}
        {%- if media.media_type == 'image' -%}
          <li class="lightbox__item">
            <img
              src="{{ media | image_url: width: 2400 }}"
              width="{{ media.width }}"
              height="{{ media.height }}"
              alt="{{ media.alt | escape }}"
              loading="lazy"
              data-lightbox-image
            >
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </dialog>

  {% render 'product-schema', product: product, variant: current_variant %}
</product-page>

{% schema %}
{
  "name": "Product",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "sticky_add", "label": "Sticky add to cart on phones", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "eyebrow",
      "name": "Small heading",
      "limit": 1,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "info": "Empty shows the product type" }]
    },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Shop Pay / Apple Pay button", "default": true }
      ]
    },
    { "type": "delivery", "name": "Lead time", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "specs",
      "name": "Specs",
      "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Specs" }]
    },
    { "type": "material", "name": "Material", "limit": 1 },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery and returns" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Or show a page" }
      ]
    }
  ]
}
{% endschema %}
