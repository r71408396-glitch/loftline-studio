{%- comment -%}
  A line of short facts and finishes that glides sideways under the hero
  (assets/home.js copies the items once and loops them; it slows down under the
  pointer). With reduced motion the items wrap and stand still.
{%- endcomment -%}
{{ 'home.css' | asset_url | stylesheet_tag }}

<div class="lh-ticker" aria-label="{{ 'sections.home_marquee.label' | t }}" role="region">
  <div class="lh-ticker-track" data-marquee="45">
    {%- for block in section.blocks -%}
      <span class="lh-ticker-item" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Home marquee",
  "class": "section-home-marquee",
  "max_blocks": 16,
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Solid walnut" }]
    }
  ],
  "presets": [
    {
      "name": "Home marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Solid walnut" } },
        { "type": "item", "settings": { "text": "Solid oak" } },
        { "type": "item", "settings": { "text": "Bamboo" } },
        { "type": "item", "settings": { "text": "Charcoal linoleum" } },
        { "type": "item", "settings": { "text": "62 to 127 cm" } },
        { "type": "item", "settings": { "text": "Holds 140 kg" } },
        { "type": "item", "settings": { "text": "Two quiet motors" } },
        { "type": "item", "settings": { "text": "10-year warranty" } }
      ]
    }
  ]
}
{% endschema %}
