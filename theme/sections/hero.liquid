{%- comment -%}
  Headline on the left, product visual on the right. The visual is an image
  for now; the configurator's 3D desk viewer replaces it once it is built.
{%- endcomment -%}
<section class="section hero" aria-labelledby="HeroHeading-{{ section.id }}">
  <div class="page-width hero__grid">
    <div class="hero__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {%- endif -%}
      <h1 id="HeroHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="hero__lead rte">{{ section.settings.text }}</div>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label | escape }}
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.collections_url }}">
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="hero__points">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- capture still -%}
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '480, 640, 800, 1000, 1200, 1400, 1600',
            sizes: '(min-width: 990px) 55vw, 100vw',
            preload: true,
            fetchpriority: 'high'
        }}
      {%- elsif section.settings.visual == 'desk_3d' -%}
        <img
          src="{{ 'desk-poster.webp' | asset_url }}"
          width="1600"
          height="1334"
          alt="{{ 'sections.hero.poster_alt' | t }}"
          fetchpriority="high"
        >
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    {%- endcapture -%}

    {%- if section.settings.visual == 'desk_3d' -%}
      <script src="{{ 'desk-hero.js' | asset_url }}" type="module"></script>
      <desk-hero
        class="hero__visual hero__visual--3d"
        data-viewer-src="{{ 'desk-viewer.js' | asset_url }}"
        data-config='{"top":"{{ section.settings.top }}","frame":"{{ section.settings.frame }}","edge":"rounded","width":1.6,"depth":0.8,"accessories":{"monitor_arm":true,"desk_pad":true}}'
      >
        <div class="hero__still">{{ still }}</div>
        <div class="hero__stage" data-stage tabindex="-1" aria-label="{{ 'sections.hero.stage_label' | t }}"></div>
        <button type="button" class="hero__load button button--secondary" data-load-3d>
          {{ 'sections.hero.load_3d' | t }}
        </button>
      </desk-hero>
    {%- else -%}
      <div class="hero__visual">{{ still }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Modular standing desks" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build the desk that fits your room and your work." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pick the width, top and frame colour, add the parts you need, and see the price and delivery date before you order.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Build yours" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Second button label", "default": "Shop accessories" },
    { "type": "url", "id": "secondary_link", "label": "Second button link" },
    {
      "type": "select",
      "id": "visual",
      "label": "Visual",
      "options": [
        { "value": "desk_3d", "label": "3D desk, turning" },
        { "value": "image", "label": "Image" }
      ],
      "default": "desk_3d"
    },
    {
      "type": "select",
      "id": "top",
      "label": "3D desk top",
      "options": [
        { "value": "oak", "label": "Oak" },
        { "value": "walnut", "label": "Walnut" },
        { "value": "bamboo", "label": "Bamboo" },
        { "value": "white", "label": "White laminate" },
        { "value": "linoleum", "label": "Charcoal linoleum" }
      ],
      "default": "oak"
    },
    {
      "type": "select",
      "id": "frame",
      "label": "3D desk frame",
      "options": [
        { "value": "black", "label": "Black" },
        { "value": "white", "label": "White" },
        { "value": "graphite", "label": "Graphite" },
        { "value": "aluminium", "label": "Aluminium" }
      ],
      "default": "black"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "With the 3D desk, this is shown until the 3D view has loaded"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "10-year frame warranty" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "point", "settings": { "text": "10-year frame warranty" } },
        { "type": "point", "settings": { "text": "Delivery date before you pay" } },
        { "type": "point", "settings": { "text": "100-night trial" } }
      ]
    }
  ]
}
{% endschema %}
